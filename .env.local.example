# Whop Company API key — Dashboard > Developer > API Keys. NEVER commit the real value.
WHOP_API_KEY=

# Webhook signing secret — Dashboard > Developer > Webhooks (create the webhook first, see README).
WHOP_WEBHOOK_SECRET=

# Your company/business ID — visible in your Whop dashboard URL: whop.com/dashboard/<biz_xxx>
WHOP_COMPANY_ID=biz_xxx

# Filled in automatically by `pnpm setup:whop` — paste the printed values here.
WHOP_MAIN_PRODUCT_ID=
WHOP_MAIN_PLAN_ID=
WHOP_ORDER_BUMP_PRODUCT_ID=
WHOP_ORDER_BUMP_PLAN_ID=
# Combined course + order-bump plan ($94), used when the order-bump checkbox is checked.
WHOP_COMBINED_PLAN_ID=
WHOP_UPSELL_PLAN_ID=
NEXT_PUBLIC_WHOP_UPSELL_PLAN_ID=

# Your deployed site URL (used to build return/redirect URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
